<!--
  Square race gate, new look. Derived from envs/assets/gate.xml of lsy_drone_racing at commit
  ac7377baa1cfd8fef1bcdc31eeaebff382f453b7 (MIT License, Copyright (c) 2024 Learning Systems and
  Robotics Lab (LSY)); see assets/gates/NOTICE.md. Sizes, collision geoms, the body name "gate" and
  all geom names are the same as in the original. The changes are marked with "NEW" or "CHANGED".
-->
<mujoco>
  <compiler angle="degree"/>

  <!-- Assets section -->
  <asset>
    <!-- CHANGED: the four banner pictures show the word GATE (same file names, same pixel sizes) -->
    <texture name="gate_texture_top" type="2d" file="gate_top.png" />
    <texture name="gate_texture_bottom" type="2d" file="gate_bottom.png" />
    <texture name="gate_texture_left" type="2d" file="gate_left.png" />
    <texture name="gate_texture_right" type="2d" file="gate_right.png" />
    <!-- NEW: bark picture of the post, 256 x 2560 pixels for a face of 0.1 m x 1.0 m -->
    <texture name="gate_texture_post" type="2d" file="gate_post_bark.png" />
    <!-- NEW: one coil spring, wire along its local z axis from z = 0 to z = 0.0707107 m -->
    <mesh name="gate_spring" file="spring.stl" inertia="shell"/>
    <material name="gate_mat_top" texture="gate_texture_top" specular="0.5" shininess="0.3" reflectance="0.0" emission="0.2"/>
    <material name="gate_mat_bottom" texture="gate_texture_bottom" specular="0.5" shininess="0.3" reflectance="0.0" emission="0.2"/>
    <material name="gate_mat_left" texture="gate_texture_left" specular="0.5" shininess="0.3" reflectance="0.0" emission="0.2"/>
    <material name="gate_mat_right" texture="gate_texture_right" specular="0.5" shininess="0.3" reflectance="0.0" emission="0.2"/>
    <!-- CHANGED: neon yellow (240, 255, 0) / 255, glowing: emission 1 adds the full color in shade -->
    <material name="frame_mat" rgba="0.941176 1 0 1" specular="0.4" shininess="0.4" reflectance="0.5" emission="1"/>
    <!-- CHANGED: spring red (214, 40, 40) / 255 -->
    <material name="rope_mat" rgba="0.839216 0.156863 0.156863 1" specular="0.3" shininess="0.3" reflectance="0.0" emission="0.25"/>
    <!-- NEW: bark material for the post -->
    <material name="gate_mat_post" texture="gate_texture_post" specular="0.0" shininess="0.0" reflectance="0.0" emission="0.15"/>
    <material name="stand_mat" rgba="0.7 0.58 0.45 1" specular="0.0" shininess="0.0" reflectance="0.0"/>
  </asset>

  <worldbody>
    <body name="gate">
      <!-- Textured front -->
      <geom name="front_top" type="box" size=".3 .05 5e-4" pos="-1e-3 0.0 0.25" euler="-90 -90 180" material="gate_mat_top" contype="0" conaffinity="0"/>
      <geom name="front_bottom" type="box" size=".3 .05 5e-4" pos="-1e-3 0.0 -0.25" euler="-90 -90 180" material="gate_mat_bottom" contype="0" conaffinity="0"/>
      <geom name="front_left" type="box" size=".05 .2 5e-4" pos="-1e-3 -0.25 0" euler="90 -90 180" material="gate_mat_left" contype="0" conaffinity="0"/>
      <geom name="front_right" type="box" size=".05 .2 5e-4" pos="-1e-3 0.25 0" euler="90 -90 180" material="gate_mat_right" contype="0" conaffinity="0"/>

      <!-- Textured back -->
      <geom name="back_top" type="box" size=".3 .05 5e-4" pos="1e-3 0.0 0.25" euler="90 90 0" material="gate_mat_top" contype="0" conaffinity="0"/>
      <geom name="back_bottom" type="box" size=".3 .05 5e-4" pos="1e-3 0.0 -0.25" euler="90 90 0" material="gate_mat_bottom" contype="0" conaffinity="0"/>
      <geom name="back_left" type="box" size=".05 .2 5e-4" pos="1e-3 -0.25 0" euler="90 90 0" material="gate_mat_left" contype="0" conaffinity="0"/>
      <geom name="back_right" type="box" size=".05 .2 5e-4" pos="1e-3 0.25 0" euler="90 90 0" material="gate_mat_right" contype="0" conaffinity="0"/>

      <!-- Frame (the material frame_mat is now neon yellow and glowing) -->
      <geom name="frame_top" type="box" size=".35 .01 .01" pos="0.0 0.01 0.35" euler="90 90 0" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="frame_bottom" type="box" size=".35 .01 .01" pos="0.0 -0.01 -0.35" euler="90 90 0" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="frame_left" type="box" size=".01 .35 .01" pos="0.0 -0.35 0.01" euler="90 90 0" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="frame_right" type="box" size=".01 .35 .01" pos="0.0 0.35 -0.01" euler="90 90 0" material="frame_mat" contype="0" conaffinity="0"/>

      <!-- CHANGED: the four ropes are red coil springs. Each one is the mesh gate_spring, whose
           z axis runs from pos (the first end point of the old rope) to the second end point of
           the old rope; quat turns z onto that line (see tools/make_spring_mesh.py). -->
      <geom name="rope_top_left" type="mesh" mesh="gate_spring" pos="0.0 -0.34 0.34" quat="0.3826834 -0.9238795 0 0" material="rope_mat" contype="0" conaffinity="0"/>
      <geom name="rope_top_right" type="mesh" mesh="gate_spring" pos="0.0 0.34 0.34" quat="0.3826834 0.9238795 0 0" material="rope_mat" contype="0" conaffinity="0"/>
      <geom name="rope_bottom_left" type="mesh" mesh="gate_spring" pos="0.0 -0.34 -0.34" quat="0.9238795 -0.3826834 0 0" material="rope_mat" contype="0" conaffinity="0"/>
      <geom name="rope_bottom_right" type="mesh" mesh="gate_spring" pos="0.0 0.34 -0.34" quat="0.9238795 0.3826834 0 0" material="rope_mat" contype="0" conaffinity="0"/>

      <!-- Stand. CHANGED: the material is the bark material. A 2d texture is projected along the
           local z axis of a box, so on the long sides of the post it would smear; the four thin
           panels below carry the picture there. The stand itself keeps its size and collision. -->
      <geom name="gate_stand" type="box" size="0.05 0.05 0.5" pos="0 0 -0.86" material="gate_mat_post" contype="1" conaffinity="1"/>

      <!-- NEW: bark panels on the four long sides of the post. Each is a thin box of 0.1 m x 1.0 m
           (half sizes 0.05 and 0.5) whose local x axis is horizontal, local y axis points up and
           local z axis points out of the post; the picture (256 x 2560) fills the +z face once. -->
      <geom name="post_bark_px" type="box" size="0.05 0.5 5e-4" pos="0.0506 0 -0.86" xyaxes="0 1 0 0 0 1" material="gate_mat_post" contype="0" conaffinity="0"/>
      <geom name="post_bark_nx" type="box" size="0.05 0.5 5e-4" pos="-0.0506 0 -0.86" xyaxes="0 -1 0 0 0 1" material="gate_mat_post" contype="0" conaffinity="0"/>
      <geom name="post_bark_py" type="box" size="0.05 0.5 5e-4" pos="0 0.0506 -0.86" xyaxes="-1 0 0 0 0 1" material="gate_mat_post" contype="0" conaffinity="0"/>
      <geom name="post_bark_ny" type="box" size="0.05 0.5 5e-4" pos="0 -0.0506 -0.86" xyaxes="1 0 0 0 0 1" material="gate_mat_post" contype="0" conaffinity="0"/>

      <!-- Collision Geometries -->
      <geom name="col_top" type="box" pos="0 0 0.28" size="0.01 0.36 0.08" rgba="1 1 1 0" contype="1" conaffinity="1"/>
      <geom name="col_bottom" type="box" pos="0 0 -0.28" size="0.01 0.36 0.08" rgba="1 1 1 0" contype="1" conaffinity="1"/>
      <geom name="col_left" type="box" pos="0 -0.28 0" size="0.01 0.08 0.36" rgba="1 1 1 0" contype="1" conaffinity="1"/>
      <geom name="col_right" type="box" pos="0 0.28 0" size="0.01 0.08 0.36" rgba="1 1 1 0" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
