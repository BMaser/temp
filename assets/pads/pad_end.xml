<!--
  End pad: a flat round marking on the floor, 0.6 m across and 1 mm high, with the picture pad_end.png.
  Same construction as pad_start.xml (read the comment there for how the picture lands on the cylinder and
  which way is up): no collision, no joint, not a mocap body, local +y is the top of the picture.
-->
<mujoco>
  <compiler angle="degree"/>

  <asset>
    <texture name="pad_end_tex" type="2d" file="pad_end.png" />
    <material name="pad_end_mat" texture="pad_end_tex" rgba="1 1 1 1" specular="0" shininess="0" reflectance="0" emission="1"/>
  </asset>

  <worldbody>
    <body name="pad_end">
      <geom name="pad_end_disc" type="cylinder" size="0.3 0.0005" pos="0 0 0.0005" material="pad_end_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
